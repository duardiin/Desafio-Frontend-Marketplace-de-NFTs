# Ativa a camada de mocks (MSW). Deve ficar true também no build publicado.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST feitas pelo cliente Axios.
VITE_API_URL=/api
# Cenário padrão dos mocks (ver README para a lista de cenários).
VITE_MOCK_SCENARIO=default
# Timeout das chamadas REST (ms). Os testes E2E usam um valor menor.
VITE_HTTP_TIMEOUT_MS=10000
# Servidor Socket.IO (com mocks, interceptado pelo MSW; não acessa a rede).
VITE_REALTIME_URL=wss://realtime.kurio.local
